{
  "name": "colab-client-profile",
  "private": true,
  "version": "2.0.0",
  "description": "CoLab case-conferencing prototype for Allegheny County DHS, built with React.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --target=es2019 --outfile=app.js",
    "watch": "esbuild src/main.jsx --bundle --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --outfile=app.js --watch --servedir=."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
